import java.util.*;
class BookNode
{
    String ISBN;
    String title;
    String author;
    String publisher;
    BookNode next;
    BookNode(String i, String t, String a, String p)
    {
        ISBN = i;
        title = t;
        author = a;
        publisher = p;
        next = null;
    }
    void displayBook()
    {
        System.out.println("ISBN: " + ISBN);
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Publisher: " + publisher);
    }
}
