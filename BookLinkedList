import java.util.*;
class BookLinkedList
{
    BookNode head;
    BookLinkedList()
    {
        head = null;
    }
    void addBook(BookNode newBook)
    {
        if(head == null)
        {
            head = newBook;
        }
        else
        {
            BookNode temp = head;
            while(temp.next != null)
            {
                temp = temp.next;
            }
            temp.next = newBook;
        }
    }
    BookNode searchBook(String isbn)
    {
        BookNode temp = head;
        while(temp != null)
        {
            if(temp.ISBN.equals(isbn))
            {
                return temp;
            }
            temp = temp.next;
        }
        return null;
    }
}
